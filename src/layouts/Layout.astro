---
/**
 * Global site layout (header/footer/SEO shell)
 * Used by every page.
 */
import "../styles/global.css";

const { title = "Pichonia", description = "From idea to launch — and beyond." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body class="bg-white text-slate-900">
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur border-b border-slate-100">
      <div class="mx-auto max-w-7xl px-6 py-3 flex items-center justify-between">
        <!-- Brand: mark + word -->
        <a href="/" class="flex items-center gap-3 font-semibold tracking-tight">
          <img
            src="/brand/pichonia_mark.svg"
            alt="Pichonia mark"
            class="shrink-0 w-14 h-14 md:w-16 md:h-16 lg:w-18 lg:h-18"
          />
          <span class="text-xl">Pichonia</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-700">
          <a href="/services" class="hover:text-slate-900">Services</a>
          <a href="/products" class="hover:text-slate-900">Products</a>
          <a href="/about" class="hover:text-slate-900">About</a>
          <a href="/contact" class="hover:text-slate-900">Contact</a>
        </nav>

        <a
          href="/contact"
          class="inline-flex items-center rounded-xl bg-[#2158FF] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90"
        >
          Start a project
        </a>
      </div>
    </header>

    <main class="min-h-screen">
      <slot />
    </main>

    <footer class="border-t border-slate-100 mt-16">
      <div class="mx-auto max-w-7xl px-6 py-10 grid gap-6 md:grid-cols-3">
        <div>
            <div class="text-lg font-semibold">Pichonia</div>
            <p class="mt-2 text-sm text-slate-600">
                From idea to launch — and beyond.
            </p>

            <div class="mt-3 text-sm text-slate-600 grid gap-1">
                <div>
                <a class="hover:text-slate-900" href="mailto:info@pichonia.com">info@pichonia.com</a>
                </div>
                <div>+1 202-670-7299</div>
                <div>Dover, Delaware</div>
            </div>
            </div>

        <div class="text-sm">
          <div class="font-semibold mb-2">Explore</div>
          <ul class="grid gap-1 text-slate-600">
            <li><a href="/services" class="hover:text-slate-900">Services</a></li>
            <li><a href="/products" class="hover:text-slate-900">Products</a></li>
            <li><a href="/about" class="hover:text-slate-900">About</a></li>
            <li><a href="/contact" class="hover:text-slate-900">Contact</a></li>
          </ul>
        </div>

        <div class="text-sm">
          <div class="font-semibold mb-2">Legal</div>
          <ul class="grid gap-1 text-slate-600">
            <li><a href="/policies/privacy" class="hover:text-slate-900">Privacy Policy</a></li>
            <li><a href="/policies/terms" class="hover:text-slate-900">Terms of Service</a></li>
          </ul>
        </div>
      </div>

      <div class="text-center text-xs text-slate-500 pb-6">
        © {new Date().getFullYear()} Pichonia LLC. All rights reserved.
      </div>
    </footer>
  </body>
</html>
