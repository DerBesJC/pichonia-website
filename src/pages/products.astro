---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Products — Pichonia">
  <!-- HERO -->
  <section class="section">
    <p class="eyebrow">Products / Lab</p>
    <h1 class="h1 mt-3">Products / Lab</h1>
    <p class="lead mt-4 max-w-2xl">
      We build for clients — and we build for ourselves. These products show how we execute.
    </p>
  </section>

  <!-- PRODUCT CARDS -->
  <section class="section-tight pb-20">
    <div class="grid gap-6 md:grid-cols-2">
      <article class="card">
        <div class="eyebrow">Logistics Marketplace</div>
        <h2 class="text-2xl font-bold mt-2">Dropt</h2>

        <p class="mt-3 text-slate-600 leading-relaxed">
          Uber for trucks — a marketplace where truck owners list vehicles and drivers,
          and customers request nearby trucks for short or long-distance jobs.
        </p>

        <ul class="list">
          <li>Truck listing + driver assignment</li>
          <li>Nearby discovery + request/accept</li>
          <li>Real-time job tracking</li>
          <li>Ratings + reliability signals</li>
        </ul>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">Build something similar</a>
          <a href="/contact" class="btn-secondary">Talk logistics</a>
        </div>
      </article>

      <article class="card">
        <div class="eyebrow">Market Prediction AI</div>
        <h2 class="text-2xl font-bold mt-2">Derbest AI</h2>

        <p class="mt-3 text-slate-600 leading-relaxed">
          Options-focused prediction AI that analyzes market conditions and surfaces
          high-probability trades designed to maximize profit.
        </p>

        <ul class="list">
          <li>Regime + volatility analysis</li>
          <li>Signal generation for options</li>
          <li>Risk-aware trade selection</li>
          <li>Clear, actionable outputs</li>
        </ul>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">Build AI for my domain</a>
          <a href="/contact" class="btn-secondary">Talk AI strategy</a>
        </div>
      </article>
    </div>
  </section>
</Layout>
