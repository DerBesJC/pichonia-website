---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found — Pichonia">
  <main class="section text-center min-h-[60vh] flex flex-col items-center justify-center">
    <p class="eyebrow">404</p>
    <h1 class="h1 mt-3">Page not found</h1>

    <p class="mt-4 text-slate-600 max-w-md">
      The page you’re looking for doesn’t exist. It might have moved, or the URL
      may be incorrect.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn-primary">
        Back to home
      </a>
      <a href="/contact" class="btn-secondary">
        Contact Pichonia
      </a>
    </div>
  </main>
</Layout>
