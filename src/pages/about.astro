---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Pichonia">
  <!-- HERO -->
  <section class="section">
    <p class="eyebrow">About</p>
    <h1 class="h1 mt-3">About Pichonia</h1>

    <p class="lead mt-4 max-w-3xl">
      Pichonia is a product and consulting studio focused on practical software.
      We help teams go from idea to launch — and we stay to maintain and grow what we build.
    </p>
  </section>

  <!-- MISSION / VALUES / DIFFERENCE -->
  <section class="section-tight">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="card">
        <div class="text-lg font-semibold">Mission</div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          Turn ideas into reliable products people can use — then improve them continuously.
        </p>
      </div>

      <div class="card">
        <div class="text-lg font-semibold">What we value</div>
        <ul class="list">
          <li>Clarity over complexity</li>
          <li>Speed with correctness</li>
          <li>Shipping over hype</li>
          <li>Long-term reliability</li>
        </ul>
      </div>

      <div class="card">
        <div class="text-lg font-semibold">Why we’re different</div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          We build and run our own products (Dropt, Derbest AI). That keeps our standards high
          and our consulting grounded in real execution.
        </p>
      </div>
    </div>
  </section>

  <!-- LOCATION / CONTACT CRED -->
  <section class="section">
    <div class="card-muted grid gap-4 md:grid-cols-3 md:items-center">
      <div>
        <div class="eyebrow">Headquarters</div>
        <div class="mt-2 font-semibold text-slate-900">Dover, Delaware</div>
        <p class="mt-1 text-sm text-slate-600">
          Registered in the U.S. — remote-first delivery.
        </p>
      </div>

      <div>
        <div class="eyebrow">Contact</div>
        <div class="mt-2 text-sm text-slate-700">
          <div><span class="font-semibold text-slate-900">Email:</span> info@pichonia.com</div>
          <div class="mt-1"><span class="font-semibold text-slate-900">Phone:</span> +1 202-670-7299</div>
        </div>
      </div>

      <div class="md:text-right">
        <a href="/contact" class="btn-primary">Start a project</a>
      </div>
    </div>
  </section>
</Layout>
