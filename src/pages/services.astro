---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Services — Pichonia";
const pageDescription =
  "AI solutions, mobile & web apps, and long-term product maintenance. From idea to launch — and beyond.";
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- HERO -->
  <section class="section">
    <p class="eyebrow">Consulting / Studio</p>
    <h1 class="h1 mt-3">Services</h1>
    <p class="lead mt-4 max-w-2xl">
      We partner with founders and teams to design, build, and maintain products that ship.
      Whether it’s an app, an AI system, or a full platform — we deliver end-to-end.
    </p>
  </section>

  <!-- SERVICE CARDS -->
  <section class="section-tight">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="card">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#2158FF]"></span>
          <div class="text-lg font-semibold">AI Solutions</div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          LLM products, automation, forecasting, and domain-specific AI systems.
          We turn messy data and workflows into clear outcomes.
        </p>
        <ul class="list">
          <li>LLM apps & copilots</li>
          <li>Prediction & optimization</li>
          <li>Workflow automation</li>
          <li>Custom AI integrations</li>
        </ul>
      </div>

      <div class="card">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#2158FF]"></span>
          <div class="text-lg font-semibold">Mobile & Web Apps</div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          MVPs, marketplaces, dashboards, and consumer apps — designed for speed and scale.
        </p>
        <ul class="list">
          <li>iOS / Android / cross-platform</li>
          <li>Web platforms & admin panels</li>
          <li>Payments, maps, realtime, auth</li>
          <li>App store / Play store launch</li>
        </ul>
      </div>

      <div class="card">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#2158FF]"></span>
          <div class="text-lg font-semibold">Maintenance & Growth</div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          After launch, we keep products reliable, fast, and improving.
        </p>
        <ul class="list">
          <li>Monitoring & uptime</li>
          <li>Performance tuning</li>
          <li>Feature roadmap support</li>
          <li>Security & compliance updates</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section">
    <h2 class="h2">How we work</h2>

    <div class="mt-8 grid gap-6 md:grid-cols-4">
      <div class="card-muted">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-white border border-slate-200 flex items-center justify-center font-bold text-sm">1</div>
          <div class="font-semibold">Discovery</div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          We clarify scope, users, success metrics, and constraints.
        </p>
      </div>

      <div class="card-muted">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-white border border-slate-200 flex items-center justify-center font-bold text-sm">2</div>
          <div class="font-semibold">Design</div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          UX flows, UI mockups, architecture, and a launch plan.
        </p>
      </div>

      <div class="card-muted">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-white border border-slate-200 flex items-center justify-center font-bold text-sm">3</div>
          <div class="font-semibold">Build & Launch</div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          Fast iterations, weekly demos, and a clean store / web release.
        </p>
      </div>

      <div class="card-muted">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-white border border-slate-200 flex items-center justify-center font-bold text-sm">4</div>
          <div class="font-semibold">Beyond</div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          Maintenance, scaling, analytics, and new features.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight pb-20">
    <div class="card flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="text-xl font-bold">Let’s talk about your project.</div>
        <p class="mt-1 text-sm text-slate-600">
          We’ll respond with a clear plan, timeline, and next steps.
        </p>
      </div>
      <a href="/contact" class="btn-primary">Book a consult</a>
    </div>
  </section>
</Layout>
