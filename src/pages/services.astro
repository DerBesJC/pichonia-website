---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Policy links (kept from your original file)
const policies = [
  { name: "Company policies", url: "https://policies.pichonia.com/" },
  { name: "Dropt (logistics)", url: "https://policies.pichonia.com/logistics/" },
  { name: "Derbest AI (markets)", url: "https://policies.pichonia.com/trading_ai/" },
];

// Load all "messaging" entries from src/content/messaging/*
const allEntries = await getCollection("messaging");

// Fail fast if any entry is missing required fields
for (const entry of allEntries) {
  if (!entry.data?.title) {
    throw new Error(
      `Messaging content missing "title" in frontmatter: src/content/messaging/${entry.slug}.md`
    );
  }
}

// Normalize + sort by optional `order` frontmatter
const ordered = allEntries
  .map((entry) => ({
    ...entry,
    ord: typeof entry.data.order === "number" ? entry.data.order : 999,
  }))
  .sort((a, b) => a.ord - b.ord);

// Pre-render markdown so we can use <Content /> components
const rendered = await Promise.all(
  ordered.map(async (entry) => {
    const out = await entry.render();
    return { entry, Content: out.Content };
  })
);

// Helper to build stable section IDs from titles
function sectionId(title) {
  return String(title)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}
---


<Layout title="Services — Pichonia">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-bold mb-6">Services</h1>

    <!-- Top-of-page jump links built from content titles -->
    <nav class="mb-8 text-sm">
      <ul class="flex flex-wrap gap-3">
        {rendered.map(({ entry }) => (
          <li>
            <a
              href={`#${sectionId(entry.data.title)}`}
              class="underline"
            >
              {entry.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- One section per messaging doc (About, Services, Capabilities, etc.) -->
    {rendered.map(({ entry, Content }) => (
      <section
        id={sectionId(entry.data.title)}
        class="prose prose-neutral max-w-none mb-12"
        data-slug={entry.slug}
      >
        <h2 class="text-2xl font-semibold mb-3">
          {entry.data.title}
        </h2>
        <Content />
      </section>
    ))}

    <!-- Policy links (same intent as your original page) -->
    <section class="prose prose-neutral max-w-none mb-8">
      <h2 class="text-2xl font-semibold mb-3">Policy Links</h2>
      <ul class="list-disc pl-5">
        {policies.map((p) => (
          <li>
            <a href={p.url} rel="noopener noreferrer" class="underline">
              {p.name}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Simple contact block at the bottom -->
    <section class="prose prose-neutral max-w-none text-sm text-slate-700">
      <h2 class="text-xl font-semibold mb-2">Contact</h2>
      <p>
        Questions or projects? Email{" "}
        <a href="mailto:info@pichonia.com" class="underline">
          info@pichonia.com
        </a>{" "}
        or use the{" "}
        <a href="/contact" class="underline">
          contact form
        </a>.
      </p>
    </section>
  </main>
</Layout>
